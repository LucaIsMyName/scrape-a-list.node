{
  "url": "https://example.com/concerts",
  "container": ".event-list",
  "item": ".event-card",
  "fields": "title:.event-title, date:.event-date, venue:.event-venue",
  "output": "",
  "paginate": true,
  "strategy": "next-link",
  "nextSelector": "a.pagination-next",
  "nextUrlSourceSelector": "",
  "nextUrlAttribute": "",
  "nextSiblingSelector": "",
  "urlTemplate": "",
  "maxPages": 0,
  "retryAttempts": 0,
  "retryDelayMs": 0,
  "pageDelayMs": 0,
  "failOnPageError": false,
  "presets": [
    {
      "presetName": "diakonie-angebote",
      "url": "https://www.diakonie.at/unsere-angebote-und-einrichtungen/liste",
      "container": ".facility-list",
      "item": ".card-item ",
      "fields": "title:.title, subtitle:.subtitle, location:.location",
      "paginate": true,
      "strategy": "next-link",
      "nextSelector": "a.page-link.arrow-next"
    },
    {
      "presetName": "Rockhouse Konzerte",
      "url": "https://www.rockhouse.at/Veranstaltungen",
      "container": "[aria-label='Veranstaltungen']",
      "item": "[aria-label='Veranstaltungen'] > li",
      "fields": "dateAndLocation:time, artist:li h3",
      "paginate": false,
      "strategy": "next-link",
      "nextSelector": "#calendar_navigation_bottom a#next_month",
      "nextUrlSourceSelector": "#dropdown_months option[selected]",
      "nextUrlAttribute": "value",
      "nextSiblingSelector": "option"
    },
    {
      "presetName": "imdb-top-250",
      "url": "https://www.imdb.com/chart/top/",
      "container": "body",
      "item": "li.ipc-metadata-list-summary-item",
      "fields": "rankingNumber:h3.ipc-title__text, name:h3.ipc-title__text, year:span.cli-title-metadata-item:nth-of-type(1), length:span.cli-title-metadata-item:nth-of-type(2), stars:span.ipc-rating-star--rating",
      "paginate": false
    },
    {
      "presetName": "quotes-toscrape",
      "url": "http://quotes.toscrape.com/",
      "container": "body",
      "item": "div.quote",
      "fields": "text:.text, author:.author, tags:.tags",
      "paginate": true,
      "strategy": "next-link",
      "nextSelector": "li.next a"
    },
    {
      "presetName": "books-toscrape",
      "url": "http://books.toscrape.com/",
      "container": "ol.row",
      "item": "li article.product_pod",
      "fields": "title:h3 a, link:h3 a@href, price:p.price_color, availability:p.instock.availability",
      "paginate": true,
      "strategy": "next-link",
      "nextSelector": "li.next a"
    },
    {
      "presetName": "hacker-news-front-page",
      "url": "https://news.ycombinator.com/",
      "container": "body",
      "item": "tr.athing",
      "fields": "rankingNumber:.rank, title:.titleline > a, url:.titleline > a@href",
      "paginate": false
    },
    {
      "presetName": "events-next-link",
      "url": "https://example.com/concerts",
      "container": ".event-list",
      "item": ".event-card",
      "fields": "title:.event-title, date:.event-date, venue:.event-venue",
      "paginate": true,
      "strategy": "next-link",
      "nextSelector": "a.pagination-next"
    },
    {
      "presetName": "events-url-pattern",
      "strategy": "url-pattern",
      "urlTemplate": "https://example.com/concerts?page={page}",
      "maxPages": 5,
      "retryAttempts": 1,
      "retryDelayMs": 300
    }
  ]
}
