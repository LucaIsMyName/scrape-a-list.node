      "paginate": true,
      "strategy": "next-link",
      "nextSelector": "a.page-link.arrow-next"
    },
    {
      "presetName": "Diakonie News Stories",
      "url": "https://www.diakonie.at/news-stories",
      "container": ".news-list",
      "item": ".news-item",
      "fields": "name:.title, date:.date, kategorien:.news-label, url:a@href",
      "paginate": true,
      "strategy": "next-link",
      "nextSelector": "a.page-link.arrow-next"
    },
    {
      "presetName": "Diakonie Freiwilligenbörse",
      "url": "https://www.diakonie.at/spenden-und-unterstuetzen/freiwilliges-engagement/freiwilligenboerse",
      "container": ".job-offer-list",
      "item": ".job-offer-item",
      "fields": "name:.job-title, location:.location, url:a@href",
      "paginate": true,
      "strategy": "next-link",
      "nextSelector": "a.page-link.arrow-next"
    },
    {
      "presetName": "Diakonie Veranstaltungen",
      "url": "https://www.diakonie.at/veranstaltungen",
      "container": ".event-overview-list",
      "item": ".grid-item",
      "fields": "name:.title, subtitle:.subtitle, location:.location, date:.date-time-wrapper, url:a@href",
      "paginate": true,
      "strategy": "next-link",
      "nextSelector": "a.page-link.arrow-next"
    },
    {
      "presetName": "Diakonie Mediathek",
      "url": "https://www.diakonie.at/mediathek",
      "container": ".main-content",
      "item": ".media",
      "fields": "name:.title, description:.text, category:.category-label, url:a.download@href",
      "paginate": true,
      "strategy": "next-link",
      "nextSelector": "a.page-link.arrow-next"
    },
    {
      "presetName": "Rockhouse Konzerte",
      "url": "https://www.rockhouse.at/de/events",
      "container": "[aria-label='Veranstaltungen']",
      "item": "[aria-label='Veranstaltungen'] > li",
      "fields": "dateAndLocation:time, artist:li h3, url:a@href",
      "paginate": false,
      "strategy": "next-link",
      "nextSelector": "#calendar_navigation_bottom a#next_month",
      "nextUrlSourceSelector": "#dropdown_months option[selected]",
      "nextUrlAttribute": "value",
      "nextSiblingSelector": "option"
    },
    {
      "presetName": "IMDB Top 250 (Work in progress)",
      "url": "https://www.imdb.com/chart/top/",
      "container": "body",
      "item": "li.ipc-metadata-list-summary-item",
      "fields": "rankingNumber:h3.ipc-title__text, name:h3.ipc-title__text, year:span.cli-title-metadata-item:nth-of-type(1), length:span.cli-title-metadata-item:nth-of-type(2), stars:span.ipc-rating-star--rating",
      "paginate": false,
      "strategy": "next-link",
      "nextSelector": ""
    },
    {
      "presetName": "Zitate von quotes.com",
      "url": "http://quotes.toscrape.com/",
      "container": "body",
      "item": "div.quote",
      "fields": "text:.text, author:.author, tags:.tags",
      "paginate": true,
      "strategy": "next-link",
      "nextSelector": "li.next a"
    },
    {
      "presetName": "Bücher von books.toscrape.com",
      "url": "http://books.toscrape.com/",
      "container": "ol.row",
      "item": "li article.product_pod",
      "fields": "title:h3 a, price:p.price_color, availability:p.instock.availability, url:a@href",
      "paginate": true,
      "strategy": "next-link",
      "nextSelector": "li.next a"
    },
    {
      "presetName": "Hacker-News Startseite",
      "url": "https://news.ycombinator.com/",
      "container": "body",
      "item": "tr.athing",
      "fields": "rankingNumber:.rank, title:.titleline > a, url:.titleline a@href",
      "paginate": true,
      "strategy": "next-link",
      "nextSelector": ".morelink"
    }
  ]
}
