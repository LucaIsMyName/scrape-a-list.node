{
  "name": "scrape-a-list.node",
  "version": "2026.09.27.1",
  "description": "CLI web scraper that extracts any list from any website",
  "type": "module",
  "license": "MIT",
  "author": "LucaIsMyName",
  "engines": {
    "node": ">=20"
  },
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./orchestrator": "./src/orchestrator.js",
    "./scraper": "./src/scraper.js",
    "./paginator": "./src/paginator.js",
    "./csv": "./src/csv.js",
    "./urlSafety": "./src/urlSafety.js",
    "./config": "./src/config/loadScrapeConfig.js"
  },
  "bin": {
    "scrape-a-list": "./index.js"
  },
  "scripts": {
    "start": "node index.js",
    "gui": "node gui/server.js",
    "gui:dev": "concurrently -k -n api,web -c blue,magenta \"node gui/server.js\" \"vite --config gui/web/vite.config.ts\"",
    "gui:build": "vite build --config gui/web/vite.config.ts",
    "gui:typecheck": "tsc --noEmit -p gui/web/tsconfig.json",
    "deploy": "bash scripts/deploy.sh",
    "test": "node --test",
    "lint": "node --check index.js cli/index.js cli/prompts.js cli/loadConfig.js cli/allowPrivateNetwork.js src/lib/sleep.js src/config/loadScrapeConfig.js src/*.js tests/*.js gui/server.js",
    "ci:test": "npm run lint && npm run gui:typecheck && npm run gui:build && npm test"
  },
  "dependencies": {
    "axios": "^1.7.0",
    "cheerio": "^1.0.0",
    "express": "^5.2.1",
    "inquirer": "^9.2.0",
    "json2csv": "^6.0.0-alpha.2"
  },
  "devDependencies": {
    "@hookform/resolvers": "^5.9.1",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-collapsible": "^1.1.20",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-scroll-area": "^1.2.18",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "concurrently": "^9.2.4",
    "lucide-react": "^1.48.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-hook-form": "^7.89.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "zod": "^3.25.76"
  }
}
